# AppImage 전용 아이콘 테마. 창 제목줄 버튼 아이콘만 직접 들고, 나머지는 시스템 테마에서 물려받는다.
# 왜 필요한지는 src-tauri/src/lib.rs의 use_bundled_icon_theme_in_appimage 참고.
# 아이콘은 src/*.svg를 rsvg-convert로 그린 symbolic PNG다(scripts/appimage-icons.sh로 다시 만든다).
[Icon Theme]
Name=HypewriterAppImage
Comment=Window control icons for the Hypewriter AppImage
Inherits=Adwaita,AdwaitaLegacy,hicolor
Directories=16x16/actions,16x16@2/actions

[16x16/actions]
Context=Actions
Size=16
Type=Fixed

[16x16@2/actions]
Context=Actions
Size=16
Scale=2
Type=Fixed
